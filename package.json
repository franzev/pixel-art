{
  "name": "the-ashen-archive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync:art": "node scripts/sync-art.mjs",
    "sync:attempts": "node scripts/sync-attempts.mjs && node scripts/sync-redo-completions.mjs",
    "delete:marked": "node scripts/apply-marked-deletions.mjs",
    "redo:activate": "node scripts/activate-redo.mjs",
    "render:save-attempt": "node scripts/save-render-attempt.mjs",
    "render:qa": "node scripts/build-render-qa.mjs",
    "render:check": "node scripts/validate-render.mjs",
    "export:feedback": "node scripts/export-feedback.mjs",
    "find:duplicates": "node scripts/find-duplicates.mjs",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run sync:art && npm run sync:attempts",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "postbuild": "node scripts/optimize-hosted-art.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:review": "npm run sync:art && node --test tests/review-catalog.test.mjs tests/gallery-performance.test.mjs tests/favorites-ui.test.mjs tests/activate-redo.test.mjs tests/redo-single-active.test.mjs tests/redo-completion.test.mjs tests/version-siblings.test.mjs tests/render-validation.test.mjs tests/save-render-attempt.test.mjs tests/attempt-catalog.test.mjs tests/attempt-review-ui.test.mjs && node --experimental-strip-types --test tests/review-summary.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-virtual": "^3.14.9",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260801.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.32",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "sharp": "0.35.3",
    "next": {
      "postcss": "8.5.25"
    }
  },
  "type": "module"
}
