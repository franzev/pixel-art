{
  "name": "the-ashen-archive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync:art": "node scripts/sync-art.mjs",
    "redo:activate": "node scripts/activate-redo.mjs",
    "render:qa": "node scripts/build-render-qa.mjs",
    "render:check": "node scripts/validate-render.mjs",
    "export:feedback": "node scripts/export-feedback.mjs",
    "find:duplicates": "node scripts/find-duplicates.mjs",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run sync:art",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "postbuild": "node scripts/optimize-hosted-art.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:review": "npm run sync:art && node --test tests/review-catalog.test.mjs tests/gallery-performance.test.mjs tests/favorites-ui.test.mjs tests/activate-redo.test.mjs tests/redo-single-active.test.mjs tests/version-siblings.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-virtual": "^3.14.9",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
